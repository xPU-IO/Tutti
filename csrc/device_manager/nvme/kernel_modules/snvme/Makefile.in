src := @module_root@
obj-m += snvme-core.o
obj-m += snvme.o

# ---------------------------------------------------------------------------
# Kernel-baseline selection.
#
# The unified snvme tree keeps ONE copy of the snvme-private code (tree
# root) and per-kernel-lineage copies of the upstream NVMe driver files
# under baseline/<tag>/.  The tag is picked from the kernel we are
# building against:
#
#   5.4.x  *-tlinux4*   -> 5.4-tlinux4   (Tencent tlinux4 / OpenCloudOS lineage)
#   5.4.x  vanilla      -> 5.4-tlinux4   (same NVMe driver shape; few backports)
#   5.10.x              -> 5.10          (public 5.10 LTS baseline)
#   5.11 - 5.19         -> 5.15          (public 5.15 baseline)
#   6.x                 -> 6.8           (public 6.8 baseline)
#
# Override manually with:  make SNVME_BASELINE=5.15
# ---------------------------------------------------------------------------
KVER := $(or $(KERNELRELEASE),$(shell uname -r))
KMAJ := $(word 1,$(subst ., ,$(KVER)))
KMIN := $(word 2,$(subst ., ,$(KVER)))

ifeq ($(SNVME_BASELINE),)
  ifeq ($(KMAJ),5)
    ifeq ($(KMIN),4)
      SNVME_BASELINE := 5.4-tlinux4
    else ifeq ($(KMIN),10)
      SNVME_BASELINE := 5.10
    else
      SNVME_BASELINE := 5.15
    endif
  else ifeq ($(KMAJ),6)
    SNVME_BASELINE := 6.8
  else ifeq ($(KMAJ),7)
    SNVME_BASELINE := 6.8
  else
    $(error Unsupported kernel $(KVER); supported baselines: 5.4-tlinux4 / 5.10 / 5.15 / 6.8)
  endif
endif

BL := baseline/$(SNVME_BASELINE)

# NOTE: module-internal include dirs MUST precede @module_ccflags@ (the
# libnvm UAPI dir), otherwise "ctrl.h" in baseline/*/pci.c resolves to
# libnvm's C++ header of the same name (baseline pci.c lives in a
# sub-directory, so the same-directory-first rule no longer applies).
ccflags-y += -I$(src)/peer_memory -I$(src)/compat -I$(src) -I$(src)/$(BL) @module_ccflags@

# --- snvme-core.ko: upstream core + snvme renames (per baseline) ---
# ioctl.c was split out of core.c upstream in 5.14; 5.4 and 5.10 keep
# their ioctl surface inside core.c.
snvme-core-y := $(BL)/core.o
ifeq ($(filter $(SNVME_BASELINE),5.15 6.8),$(SNVME_BASELINE))
snvme-core-y += $(BL)/ioctl.o
endif
ifeq ($(SNVME_BASELINE),6.8)
snvme-core-y += $(BL)/sysfs.o $(BL)/pr.o
snvme-core-$(CONFIG_NVME_VERBOSE_ERRORS) += $(BL)/constants.o
snvme-core-$(CONFIG_NVME_HOST_AUTH)       += $(BL)/auth.o
endif
snvme-core-$(CONFIG_NVME_MULTIPATH)  += $(BL)/multipath.o
snvme-core-$(CONFIG_BLK_DEV_ZONED)   += $(BL)/zns.o
snvme-core-$(CONFIG_NVME_HWMON)      += $(BL)/hwmon.o

# --- snvme.ko: PCI transport + the shared snvme private code ---
# peer_memory/ contains one .c per GPU P2P backend (nvidia/metax).
# Select at build time:  make TUTTI_P2P_BACKEND=nvidia (or metax)
TUTTI_P2P_BACKEND ?= nvidia
snvme-objs := peer_memory/$(TUTTI_P2P_BACKEND).o compat/compat.o list.o ctrl.o \
	      map.o snvm_control.o snvm_dev_ioctl.o snvm_qgroup.o $(BL)/pci.o

KERNEL_SRC := /lib/modules/$(shell uname -r)/build

# blk_set_queue_dying() was removed upstream in v5.17 and replaced by
# blk_mark_disk_dead(gendisk); the change was backported into some 5.15
# point-releases (e.g. Ubuntu HWE 5.15.0-185).  Decide by whether the target
# kernel actually EXPORTS blk_mark_disk_dead -- do not gate on the version
# number, because the Ubuntu ABI number is not the upstream stable SUBLEVEL.
have_bmdd := $(shell grep -qsw blk_mark_disk_dead $(KERNEL_SRC)/Module.symvers && echo 1)
ifeq ($(have_bmdd),1)
ccflags-y += -DHAVE_BLK_MARK_DISK_DEAD
endif

all:
	@mkdir -p $(CURDIR)/peer_memory $(CURDIR)/compat \
		$(CURDIR)/baseline/5.4-tlinux4 $(CURDIR)/baseline/5.10 \
		$(CURDIR)/baseline/5.15 $(CURDIR)/baseline/6.8
	$(MAKE) -C $(KERNEL_SRC) M=$(CURDIR) modules
# Queue depth: no module parameter -- snvme always takes the controller
# maximum (NVMe CAP.MQES + 1).
# Root loads directly; non-root users retain the normal sudo path.
MODULE_PRIVILEGE := $(if $(filter 0,$(shell id -u)),,sudo)
insmod:
	$(MODULE_PRIVILEGE) insmod snvme-core.ko && $(MODULE_PRIVILEGE) insmod snvme.ko
rmmod:
	$(MODULE_PRIVILEGE) rmmod snvme && $(MODULE_PRIVILEGE) rmmod snvme_core
clean:
	rm -fr *.o *.ko *.mod* .*.cmd .*.d baseline/*/*.o peer_memory/*.o compat/*.o
