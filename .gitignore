# CodeBuddy / IDE assistant local state -- per-developer, not source.
.codebuddy/

# Smoke / stress test runtime logs (written next to the binary or repo
# root; regenerated on every run).
*.log
kv_cache_e2e_stress.log

# CMake user presets are per-developer (toolchain/CUDA paths etc.).
# Commit CMakePresets.json deliberately if you ever need a shared baseline.
CMakeUserPresets.json
build_dependencies.tsv

# Smoke-test binaries built in-tree by the test/Makefile.  The .c/.cu
# sources are committed; the binaries are not.
csrc/device_manager/nvme/kernel_modules/test/snvme_smoke
csrc/device_manager/nvme/kernel_modules/test/snvme_smoke_gpu
csrc/device_manager/nvme/kernel_modules/test/snvme_smoke_addq
