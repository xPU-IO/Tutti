csrc/device_manager/nvme/kernel_modules/test/snvme_smoke_io
csrc/device_manager/nvme/kernel_modules/test/snvme_ubind

# Nsight Systems profile output -- per-run, not source.
*.nsys-rep
*.sqlite

# Stress test sweep logs + stdout captures (per-run, not source)
sweep_logs/

# Exported chat history (not source)
history_*.md
