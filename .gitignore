Module.symvers
modules.order
*.o
*.ko
*.mod
*.mod.c

# vLLM integration orchestration runtime state (task cards, receipts,
# board, round scratch) -- per-run collaboration artifacts, not source.
doc/intergration/ai-orch/
doc/intergration/rounds/

# scripts/tutti-env.sh 的默认日志/PID 目录（TUTTI_LOG_DIR 可覆盖）
.local/

# pytest-benchmark 产物（即使没跑 benchmark 也会建空目录）
.benchmarks/
# pytest 缓存（pyproject 已加 -p no:cacheprovider，此为兜底）
.pytest_cache/

# Python
__pycache__/
*.pyc
