src := @module_root@

# snvme-core: kernel-version-portable half of the module pair.
#
# 5.4 layout differences vs 5.15:
#   - 5.4 has no separate ioctl.c (NVME_IOCTL_* lives in core.c)
#   - 5.4 has no zns.c (Zoned Namespaces support landed post-5.4)
#   - 5.4 has no hwmon.c (NVMe hwmon support landed post-5.4)
#   - 5.4 still has fault_inject.c / lightnvm.c / trace.c / fc.c, but
#     snvme intentionally drops fault_inject/fc/trace and we also drop
#     lightnvm (it was removed upstream by 5.15).
obj-m += snvme-core.o

# snvme.ko: the modified PCI driver carrying the SNVM_/NVM_ ioctl
# surface, /dev/snvm_control, /dev/ssnvme*, and the CPU/GPU queue-share
# hooks.  Segments 1-7 of the snvme-5.15 increment have been
# re-expressed against the 5.4 nvme_dev / nvme_queue layout, and the
# chrdev/ioctl plumbing (modules 2-3) is in place at pci.c lines
# 4060-4940.  See the PORTING STATUS banner at the top of pci.c for
# the per-segment status.
obj-m += snvme.o


ccflags-y += @module_ccflags@ -I$(src)/peer_memory

snvme-core-y				:= core.o
snvme-core-$(CONFIG_NVME_MULTIPATH)	+= multipath.o

# snvme.ko object list.
#
# peer_memory/ contains one .c per GPU P2P backend:
#   nvidia.c  (CUDA default)
#   metax.c   (MUSA/MACA default)
#
# Select at build time:  make TUTTI_P2P_BACKEND=nvidia (or metax)
# Default: nvidia
TUTTI_P2P_BACKEND ?= nvidia
snvme-objs := peer_memory/$(TUTTI_P2P_BACKEND).o compat.o list.o ctrl.o map.o pci.o

KERNEL_SRC := /lib/modules/$(shell uname -r)/build

all:
	@mkdir -p @module_output@/peer_memory
	$(MAKE) -C $(KERNEL_SRC) M=@module_output@ modules
# io_queue_depth: kernel default 64 is the conservative built-in; production
# deployments use 1024 (maintainer 2026-08-04). Override: make insmod IO_QDEPTH=64
IO_QDEPTH ?= 1024

insmod:
	sudo insmod snvme-core.ko && sudo insmod snvme.ko io_queue_depth=$(IO_QDEPTH)
rmmod:
	sudo rmmod snvme && sudo rmmod snvme_core
clean:
	rm -fr *.o *.ko *.mod* .*.cmd .*.d
